	<term key="dialog_tutor">pause|1000|L|||disableInput;pause|1500|L|||startShake,playSound{Temblor};ben|3000|L|What was that?||stopShake;rook|3000|R|Psyphon is invading Undertown;max|3000|L|You must complete your training before going after him!;pause|100|L|||enableInput</term>
	<term key="dialog_tutor1">pause|1500;max_tutor|5000|L|MOVE|arrows</term>	<!--  Texto: ...;personaje|segundos|L(eft)/R(ight)|texto;...  -->	<!--  Pausa: ...;pause|segundos;...  -->	<!--  IDs: max,ben,rook,pause  -->
	<term key="dialog_tutor2">max_tutor|5000|L|ATTACK|pinia;pause|2000;max_tutor|5000|L|SHOOT|disparo;pause|2000;max_tutor|5000|L|JUMP|salto</term>
	<term key="dialog_tutor3">max_tutor|5000|L|DASH|dash;pause|3000;max_tutor|5000|L|SPECIAL ATTACK|especial</term>
	
	 <term key="dialog_pasar_nivel1">max|3000|L|Good job! Your training is now complete</term>
	
	<term key="dialog_mercado">pause|1500|L|||disableInput;ben|3000|L|Psyphon followers have set a bomb!;pause|3500|L|||showBomb{1600:3};rook|3000|R|Let's destroy it before it's too late!;pause|3300|L|||backToPlayers{3};pause|100|L|||enableInput,endFreeCamera</term>
	
	<term key="dialog_bomb_about_to_explode">ben|3000|L|We must hurry!</term>
    <term key="dialog_pasar_nivel2">ben|3000|L|That was close!;rook|3000|R|I know a shortcut to Undertown;ben|3000|L|Let's go!</term>
	                                                             
	<term key="dialog_tren">pause|1500|L|||disableInput;ben|3000|L|I hope this will be a quiet ride;rook|3000|R|I expect the same, sir!;ben|3000|L|Sir? Call me Ben, Dude;rook|3000|R|Very well, Ben Dude;pause|100|L|||enableInput</term>
    <term key="dialog_pasar_nivel3">ben|3000|L|What a bumpy ride!;rook|3000|R|That's right, Ben Dude;ben|3000|L|CALL ME BEN!</term>
	
	
    <term key="dialog_subte">pause|1500|L|||disableInput;ben|3000|L|The train journey finally came to an end;rook|3000|R|My sensors indicate that more aliens are approaching;ben|3000|L|Let's go that way!;pause|100|L|||enableInput</term>
    <term key="dialog_subte1">pause|1500|L|||disableInput;ben|3000|L|Don't they ever stop? This looks like a video game;pause|1000|L|||showBomb{8200:1};rook|3000|R|But it's the real world, Ben;ben|3000|L|I know, Rook;pause|1000|L|||backToPlayers{1};pause|100|L|||enableInput,endFreeCamera</term>
    <term key="dialog_pasar_nivel4">ben|3000|L|We're close!;rook|3000|R|Let's move!</term>

    <term key="dialog_ciudad">pause|1500|L|||disableInput;ben|3000|L|What an amazing city!;rook|3000|R|You look surprised, Ben;ben|3000|L|I wasn't expecting to find something this big;rook|3000|R|Let's go! Psyphon can't be far!;pause|100|L|||enableInput</term>
    
    <term key="dialog_ciudad1">pause|1500;ben|3000|L|Be careful, he's more dangerous than he looks</term>
	
	<term key="dialog_pasar_nivel5">ben|3000|L|Good job!;rook|3000|R|We captured Psyphon!;ben|3000|L|We make a great team, Rook!</term>
	
	
