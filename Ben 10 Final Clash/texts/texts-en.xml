	    <term key="final_gwen_3_gwn">You're underestimating the power of my magic</term>
     	<term key="final_gwen_4_malware">You're an annoyance, get out of my way</term>
	
		
		<term key="final_fight_gwen_win">You are no match for arcane knowledge</term>
	    <term key="final_fight_gwen_lose">That's what you get for meddling in my plans</term>
		
		
		
		
		<term key="final_kevin_1_kevin">The only good thing about meeting you </term>
