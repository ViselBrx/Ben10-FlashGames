	<!--  VICTORY PHRASES  -->
	<!--  ===================  -->
	
	<term key="diamondhead_victory_1">You won't win this tournament if you keep fighting like that</term>
	<term key="diamondhead_victory_2">To reach you goals you need to fight harder</term>
	<term key="diamondhead_victory_3">You're no match for a Petropian gladiator</term>
	
	<term key="heatblast_victory_1">My fists are on fire!</term>
	<term key="heatblast_victory_2">Don't try to run from my strikes</term>
	<term key="heatblast_victory_3">My fire in unmatched!</term>
	
    <term key="looma_victory_1">The House of Gars has the strongest warriors!</term>
	<term key="looma_victory_2">You're no match for the princess of Khoros</term>
	<term key="looma_victory_3">You're weaker than my last fiancé!</term>
	
	<term key="feedback_victory_1">You're a terrible fighter, but at least you are a decent conductor for my electricity</term>
	<term key="feedback_victory_2">Don't get fooled by my looks, appeareances can be deceiving</term>
	<term key="feedback_victory_3">It was obvious you were going to lose, but thanks anyways for trying to entertain me for a bit</term>
	
	<term key="rook_victory_1">It takes more than strength to defeat me!</term>
	<term key="rook_victory_2">You need to train a lot harder to improve your balance</term>
	<term key="rook_victory_3">I was the best fighter at Plumber Academy!</term>
	
	
	<term key="vilgax_victory_1">Out of my sight, you worm!</term>
	<term key="vilgax_victory_2">You're a thousand years too early to go up against the great Vilgax</term>
	<term key="vilgax_victory_3">Don't make me laugh!</term>
	
	
	<term key="attea_victory_1">Not bad, you should join my army!</term>
	<term key="attea_victory_2">Kneel before me</term>
	<term key="attea_victory_3">The strength of the Incursion Army, like mine, has no equal</term>
	
	
	<term key="malware_victory_1">You aren't worthy of going against me</term>
	<term key="malware_victory_2">No one can stand in my way</term>
	<term key="malware_victory_3">I'll do whatever it takes to be whole</term>
	
	
	<term key="kryber_victory_1">You'll be a nice trophy in my collection</term>
	<term key="kryber_victory_2">You're not a prey worthy of the great Khyber</term>
	<term key="kryber_victory_3">I'm the best hunter in the galaxy</term>
	
	
	<term key="gwen_victory_1">You should study the art of magic</term>
	<term key="gwen_victory_2">Your strength is no match for my brain</term>
	<term key="gwen_victory_3">Think carefully before attacking!</term>
	
	
	<term key="kevin_victory_1">Getting here was way too easy!</term>
	<term key="kevin_victory_2">I have to repair my car, let's get this over with quickly</term>
	<term key="kevin_victory_3">Fighting against me was the stupidiest thing you have ever done</term>
	
	
	<term key="ben_victory_1">No one is strong enough to defeat me</term>
	<term key="ben_victory_2">Didn't you hear? I'm the star around here</term>
	<term key="ben_victory_3">Do you think I can get a Mr. Smoothie around here?</term>
	
	<term key="fourarms_victory_1">Nothing compares to the fists of Khoros</term>
	<term key="fourarms_victory_2">You're not a worthy rival</term>
	<term key="fourarms_victory_3">Don't try to get up</term>
	
	
	
	<!--  CHARACTER BANTER - FINAL BATTLE  -->
